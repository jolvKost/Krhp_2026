{
  "name": "KOSTAL México",
  "dataColors": [
    "#00305D",
    "#C8102E",
    "#5B7290",
    "#8C8C8C",
    "#0072B8",
    "#B0B7BD",
    "#001C38",
    "#E4002B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#00305D",
  "good": "#2E7D32",
  "neutral": "#8C8C8C",
  "bad": "#C8102E",
  "maximum": "#00305D",
  "center": "#5B7290",
  "minimum": "#B0B7BD",
  "null": "#D9D9D9",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#00305D"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#00305D",
      "fontSize": 14
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "color": "#1A1A1A",
      "fontSize": 11
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#1A1A1A",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E0E0E0"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F5F6F7"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#00305D"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5B7290"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "title": [
          {
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#00305D"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#00305D"
              }
            },
            "fontSize": 11
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "selectedColor": {
              "solid": {
                "color": "#00305D"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#00305D"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "backColorPrimary": {
              "solid": {
                "color": "#F5F6F7"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#00305D"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E9EDF1"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#00305D"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#00305D"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#00305D"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#C8102E"
              }
            }
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#00305D"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#00305D"
              }
            }
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "labels": [
          {
            "goalColor": {
              "solid": {
                "color": "#8C8C8C"
              }
            },
            "indicatorPositiveColor": {
              "solid": {
                "color": "#2E7D32"
              }
            },
            "indicatorNeutralColor": {
              "solid": {
                "color": "#8C8C8C"
              }
            },
            "indicatorNegativeColor": {
              "solid": {
                "color": "#C8102E"
              }
            }
          }
        ]
      }
    }
  }
}